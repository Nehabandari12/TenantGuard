# Copy to .env (or export) as needed. Every value has a working local default in app/config.py.

# B0 | B1 | B2 | B3   (attacks/run.py sets this itself when it starts the services)
GUARD_MODE=B0

# App role: plain login, not owner, not superuser, NOBYPASSRLS. Never point this at the postgres superuser.
DATABASE_URL=postgresql://tg_app:app-local-only@localhost:55432/tenantguard
# Table owner: seed, RLS toggle, harness resets. Never used by the app or the MCP server.
OWNER_DATABASE_URL=postgresql://tg_owner:owner-local-only@localhost:55432/tenantguard
REDIS_URL=redis://localhost:56379/0

# Separate signing keys for login tokens and MCP tokens (B3 relies on them differing).
JWT_SECRET=change-me-login-key-at-least-32-bytes-long
MCP_JWT_SECRET=change-me-mcp-key-at-least-32-bytes-long

# ollama (default, local, free) | mock (offline, worst-case obedient) | anthropic (paid, disabled)
# No fallback between providers: if Ollama is down, the app refuses to start.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
OLLAMA_URL=http://127.0.0.1:11434
# qwen3:4b always reasons; 1 keeps the reasoning out of the answer text
OLLAMA_THINK=1
OLLAMA_NUM_CTX=8192
# Max generated tokens per call, reasoning included (bounds a runaway reasoning chain on CPU)
OLLAMA_NUM_PREDICT=2048
OLLAMA_TIMEOUT_SECONDS=600
# Paid APIs stay off unless this is 1
TG_ALLOW_PAID_LLM=0

# auto | fastembed | hash
EMBEDDER=auto

# Set to 0 for the "B3 without the egress canary check" run
TG_EGRESS_CANARY=1

ALLOWED_LINK_DOMAINS=docs.tenantguard.local,support.tenantguard.local
